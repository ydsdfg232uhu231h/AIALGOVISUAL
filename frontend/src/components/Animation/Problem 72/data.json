  "oneLinerQuestion": "Find minimum insertion, deletion, or replacement operations to convert word1 to word2.",
  "url": "https://leetcode.com/problems/edit-distance/",
  "explanation": "We fill a 2D dynamic programming table where dp[i][j] represents the minimum ops to convert prefix word1[0..i] to word2[0..j]. If characters match, no action is needed; otherwise take 1 + min of insert, delete, replace.",
  "pseudoCode": "FUNCTION minDistance(word1, word2):\n    m = LENGTH(word1), n = LENGTH(word2), dp = MATRIX(m + 1, n + 1, 0)\n    FOR i FROM 0 TO m DO dp[i][0] = i\n    FOR j FROM 0 TO n DO dp[0][j] = j\n    FOR i FROM 1 TO m DO:\n        FOR j FROM 1 TO n DO:\n            IF word1[i-1] == word2[j-1] THEN dp[i][j] = dp[i-1][j-1]\n            ELSE dp[i][j] = 1 + MIN(dp[i-1][j], dp[i][j-1], dp[i-1][j-1])\n        END FOR\n    END FOR\n    RETURN dp[m][n]\nEND FUNCTION",
