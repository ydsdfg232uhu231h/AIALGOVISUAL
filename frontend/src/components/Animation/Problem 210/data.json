  "explanation": "Compute in-degrees for all courses. Seed the BFS queue with courses having 0 in-degree. As courses are dequeued and added to the result sequence, decrement in-degrees of adjacent courses and enqueue any that reach 0.",
  "pseudoCode": "FUNCTION findOrder(numCourses, prerequisites):\n    adj = HASH_MAP_OF_LISTS(), inDegree = ARRAY_OF_SIZE(numCourses, 0)\n    FOR p IN prerequisites DO APPEND p[0] TO adj[p[1]]; inDegree[p[0]] = inDegree[p[0]] + 1\n    queue = [c FOR c IN 0..numCourses-1 IF inDegree[c] == 0], res = []\n    WHILE queue IS NOT EMPTY DO:\n        c = DEQUEUE(queue); APPEND c TO res\n        FOR nxt IN adj[c] DO:\n            inDegree[nxt] = inDegree[nxt] - 1\n            IF inDegree[nxt] == 0 THEN ENQUEUE(queue, nxt)\n        END FOR\n    END WHILE\n    RETURN LENGTH(res) == numCourses ? res : []\nEND FUNCTION",
  "renderType": "kahn_topo_sort",
  "initialData": {
    "numCourses": 4,
    "prerequisites": [
      [1, 0],
      [2, 0],
      [3, 1],
      [3, 2]
    ]
  },
  "codeLines": [
    "FUNCTION findOrder(numCourses, prerequisites):",
    "    adj = HASH_MAP_OF_LISTS(), inDegree = ARRAY_OF_SIZE(numCourses, 0)",
    "    FOR p IN prerequisites DO APPEND p[0] TO adj[p[1]]; inDegree[p[0]] = inDegree[p[0]] + 1",
    "    queue = [c FOR c IN 0..numCourses-1 IF inDegree[c] == 0], res = []",
    "    WHILE queue IS NOT EMPTY DO:",
    "        c = DEQUEUE(queue); APPEND c TO res",
    "        FOR nxt IN adj[c] DO:",
    "            inDegree[nxt] = inDegree[nxt] - 1",
    "            IF inDegree[nxt] == 0 THEN ENQUEUE(queue, nxt)",
    "        END FOR",
    "    END WHILE",
    "    RETURN LENGTH(res) == numCourses ? res : []",
    "END FUNCTION"
  ],
