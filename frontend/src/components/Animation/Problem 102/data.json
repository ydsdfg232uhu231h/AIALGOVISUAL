  "pseudoCode": "FUNCTION levelOrder(root):\n    IF root IS NULL THEN RETURN []\n    queue = [root], res = []\n    WHILE queue IS NOT EMPTY DO:\n        levelSize = LENGTH(queue), currentLevel = []\n        FOR i FROM 1 TO levelSize DO:\n            node = DEQUEUE(queue)\n            APPEND node.val TO currentLevel\n            IF node.left THEN ENQUEUE(queue, node.left)\n            IF node.right THEN ENQUEUE(queue, node.right)\n        END FOR\n        APPEND currentLevel TO res\n    END WHILE\n    RETURN res\nEND FUNCTION",
