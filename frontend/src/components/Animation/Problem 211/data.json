  "oneLinerQuestion": "Build a structure that supports adding words and searching with wildcard dots.",
  "url": "https://leetcode.com/problems/design-add-and-search-words-data-structure/",
  "explanation": "Store words in Trie. For normal characters traverse children directly. For wildcard '.' character, recursively check all child branches at current node level.",
  "pseudoCode": "CLASS WordDictionary:\n    CONSTRUCTOR(): root = NEW TrieNode()\n    FUNCTION addWord(word):\n        curr = root\n        FOR c IN word DO:\n            IF c NOT IN curr.children THEN curr.children[c] = NEW TrieNode()\n            curr = curr.children[c]\n        END FOR\n        curr.isWord = True\n    FUNCTION search(word):\n        FUNCTION dfs(j, root):\n            curr = root\n            FOR i FROM j TO LENGTH(word) - 1 DO:\n                c = word[i]\n                IF c == '.' THEN:\n                    FOR child IN curr.children.values() DO:\n                        IF dfs(i + 1, child) THEN RETURN True\n                    END FOR\n                    RETURN False\n                ELSE:\n                    IF c NOT IN curr.children THEN RETURN False\n                    curr = curr.children[c]\n            END FOR\n            RETURN curr.isWord\n        END FUNCTION\n        RETURN dfs(0, root)\nEND CLASS",
  "renderType": "trie_wildcard",
