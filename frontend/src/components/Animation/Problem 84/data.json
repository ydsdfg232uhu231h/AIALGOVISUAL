  "timeComplexity": "O(n)",
  "spaceComplexity": "O(n)",
  "oneLinerQuestion": "Find the area of the largest rectangle that can be formed within a histogram.",
  "url": "https://leetcode.com/problems/largest-rectangle-in-histogram/",
  "explanation": "We use a monotonic increasing stack storing bar indices. When encountering a shorter bar, we pop taller bars from the stack, calculating the area rectangle bounded by the height of each popped bar.",
  "pseudoCode": "FUNCTION largestRectangleArea(heights):\n    stack = EMPTY_STACK(), maxArea = 0, n = LENGTH(heights)\n    FOR i FROM 0 TO n DO:\n        h = (i == n) ? 0 : heights[i]\n        WHILE NOT IS_EMPTY(stack) AND heights[TOP(stack)] > h DO:\n            height = heights[POP(stack)]\n            width = IS_EMPTY(stack) ? i : i - TOP(stack) - 1\n            maxArea = MAX(maxArea, height * width)\n        END WHILE\n        PUSH i TO stack\n    END FOR\n    RETURN maxArea\nEND FUNCTION",
  "renderType": "histogram_stack",
