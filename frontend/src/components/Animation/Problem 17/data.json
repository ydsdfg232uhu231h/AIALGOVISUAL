  "oneLinerQuestion": "Return all possible letter combinations that a digit string could represent on a phone keypad.",
  "url": "https://leetcode.com/problems/letter-combinations-of-a-phone-number/",
  "explanation": "Using depth-first search backtracking, process each digit sequentially. For each digit, iterate through its corresponding letters on the keypad, append to the prefix, and recurse until the string length matches.",
  "pseudoCode": "FUNCTION letterCombinations(digits):\n    IF digits IS EMPTY THEN RETURN []\n    map = {'2':'abc', '3':'def', '4':'ghi', '5':'jkl', '6':'mno', '7':'pqrs', '8':'tuv', '9':'wxyz'}\n    res = []\n    FUNCTION backtrack(index, currentStr):\n        IF index == LENGTH(digits) THEN APPEND currentStr TO res; RETURN\n        FOR char IN map[digits[index]] DO:\n            backtrack(index + 1, currentStr + char)\n        END FOR\n    END FUNCTION\n    backtrack(0, '')\n    RETURN res\nEND FUNCTION",
  "renderType": "tree_backtrack",
  "initialData": "23",
  "codeLines": [
    "FUNCTION letterCombinations(digits):",
    "    IF digits IS EMPTY THEN RETURN []",
    "    map = {'2':'abc', '3':'def', '4':'ghi', '5':'jkl', '6':'mno', '7':'pqrs', '8':'tuv', '9':'wxyz'}",
    "    res = []",
    "    FUNCTION backtrack(index, currentStr):",
    "        IF index == LENGTH(digits) THEN APPEND currentStr TO res; RETURN",
    "        FOR char IN map[digits[index]] DO:",
    "            backtrack(index + 1, currentStr + char)",
    "        END FOR",
    "    END FUNCTION",
    "    backtrack(0, '')",
    "    RETURN res",
    "END FUNCTION"
