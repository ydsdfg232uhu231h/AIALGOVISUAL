  "pseudoCode": "FUNCTION lastStoneWeight(stones):\n    maxHeap = MaxHeap(stones)\n    WHILE SIZE(maxHeap) > 1 DO:\n        first = POP(maxHeap)\n        second = POP(maxHeap)\n        IF first != second THEN PUSH(maxHeap, first - second)\n    END WHILE\n    RETURN SIZE(maxHeap) == 1 ? TOP(maxHeap) : 0\nEND FUNCTION",
