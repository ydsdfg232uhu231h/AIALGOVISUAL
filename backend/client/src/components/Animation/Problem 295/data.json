  "codeLines": [
    "CLASS MedianFinder:",
    "    CONSTRUCTOR(): small = MaxHeap(), large = MinHeap()",
    "    FUNCTION addNum(num):",
    "        PUSH num TO small",
    "        IF small AND large AND TOP(small) > TOP(large) THEN PUSH POP(small) TO large",
    "        IF SIZE(small) > SIZE(large) + 1 THEN PUSH POP(small) TO large",
    "        IF SIZE(large) > SIZE(small) + 1 THEN PUSH POP(large) TO small",
    "    FUNCTION findMedian():",
    "        IF SIZE(small) > SIZE(large) THEN RETURN TOP(small)",
    "        IF SIZE(large) > SIZE(small) THEN RETURN TOP(large)",
    "        RETURN (TOP(small) + TOP(large)) / 2.0",
    "END CLASS"
  ],
