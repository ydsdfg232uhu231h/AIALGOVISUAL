  "pseudoCode": "FUNCTION groupAnagrams(strs):\n    map = EMPTY_HASH_MAP()\n    FOR str IN strs DO:\n        key = SORT_CHARACTERS(str)\n        IF key NOT IN map THEN map[key] = []\n        APPEND str TO map[key]\n    END FOR\n    RETURN VALUES(map)\nEND FUNCTION",
