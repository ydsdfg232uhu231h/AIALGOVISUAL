  "difficulty": "Medium",
  "topic": "Heap / Hash Table",
  "algorithm": "Bucket Sort / Min-Heap",
  "timeComplexity": "O(n)",
  "spaceComplexity": "O(n)",
  "oneLinerQuestion": "Find the k most frequent elements in an array.",
  "url": "https://leetcode.com/problems/top-k-frequent-elements/",
  "explanation": "Count occurrences using a Hash Map, then place elements into a bucket array indexed by frequency counts. Traverse buckets backward from max frequency to collect top k numbers in O(N) time.",
  "pseudoCode": "FUNCTION topKFrequent(nums, k):\n    count = FREQ_MAP(nums), bucket = ARRAY_OF_LISTS(LENGTH(nums) + 1)\n    FOR num, freq IN count DO APPEND num TO bucket[freq]\n    res = []\n    FOR i FROM LENGTH(bucket) - 1 DOWN TO 0 DO:\n        FOR num IN bucket[i] DO:\n            APPEND num TO res\n            IF LENGTH(res) == k THEN RETURN res\n        END FOR\n    END FOR\nEND FUNCTION",
  "renderType": "bucket_sort",
  "initialData": {
    "nums": [4, 4, 4, 4, 4, 1, 1, 1, 2, 2, 3],
    "k": 3
  },
  "codeLines": [
    "FUNCTION topKFrequent(nums, k):",
    "    count = FREQ_MAP(nums), bucket = ARRAY_OF_LISTS(LENGTH(nums) + 1)",
    "    FOR num, freq IN count DO APPEND num TO bucket[freq]",
    "    res = []",
    "    FOR i FROM LENGTH(bucket) - 1 DOWN TO 0 DO:",
    "        FOR num IN bucket[i] DO:",
    "            APPEND num TO res",
    "            IF LENGTH(res) == k THEN RETURN res",
    "        END FOR",
    "    END FOR",
    "END FUNCTION"
  ],
