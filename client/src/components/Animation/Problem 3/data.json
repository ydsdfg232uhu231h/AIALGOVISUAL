  "title": "Longest Substring Without Repeating Characters",
  "difficulty": "Medium",
  "topic": "Sliding Window",
  "algorithm": "Variable Size Sliding Window & Hash Set",
  "timeComplexity": "O(n)",
  "spaceComplexity": "O(min(m, n))",
  "oneLinerQuestion": "Find the length of the longest substring containing no duplicate characters.",
  "url": "https://leetcode.com/problems/longest-substring-without-repeating-characters/",
  "explanation": "We use a sliding window approach maintained by two pointers (left and right) along with a set of visited characters. As the right pointer expands the window, if a duplicate is found, the left pointer shrinks the window from the left until all characters inside the window are unique again.",
  "pseudoCode": "FUNCTION lengthOfLongestSubstring(s):\n    charSet = EMPTY_SET(), left = 0, maxLength = 0\n    FOR right FROM 0 TO LENGTH(s) - 1 DO:\n        WHILE s[right] IN charSet DO:\n            REMOVE s[left] FROM charSet\n            left = left + 1\n        END WHILE\n        ADD s[right] TO charSet\n        maxLength = MAX(maxLength, right - left + 1)\n    END FOR\n    RETURN maxLength\nEND FUNCTION",
  "renderType": "sliding_window",
  "initialData": ["a", "b", "c", "a", "b", "c", "b", "b"],
  "codeLines": [
    "FUNCTION lengthOfLongestSubstring(s):",
    "    charSet = EMPTY_SET(), left = 0, maxLength = 0",
    "    FOR right FROM 0 TO LENGTH(s) - 1 DO:",
    "        WHILE s[right] IN charSet DO:",
    "            REMOVE s[left] FROM charSet",
    "            left = left + 1",
    "        END WHILE",
    "        ADD s[right] TO charSet",
    "        maxLength = MAX(maxLength, right - left + 1)",
    "    END FOR",
    "    RETURN maxLength",
    "END FUNCTION"
  ],
