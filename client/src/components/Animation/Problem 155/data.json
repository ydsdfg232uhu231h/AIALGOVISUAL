  "codeLines": [
    "CLASS MinStack:",
    "    CONSTRUCTOR(): stack = [], minStack = []",
    "    FUNCTION push(val):",
    "        m = IS_EMPTY(minStack) ? val : MIN(val, TOP(minStack))",
    "        PUSH val TO stack",
    "        PUSH m TO minStack",
    "    FUNCTION pop(): POP stack; POP minStack",
    "    FUNCTION top(): RETURN TOP(stack)",
    "    FUNCTION getMin(): RETURN TOP(minStack)",
    "END CLASS"
  ],
