  "pseudoCode": "FUNCTION longestConsecutive(nums):\n    numSet = SET(nums), longest = 0\n    FOR num IN numSet DO:\n        IF (num - 1) NOT IN numSet THEN:\n            length = 1\n            WHILE (num + length) IN numSet DO length = length + 1\n            longest = MAX(longest, length)\n        END IF\n    END FOR\n    RETURN longest\nEND FUNCTION",
