  "pseudoCode": "FUNCTION searchRange(nums, target):\n    first = findBound(nums, target, True)\n    IF first == -1 THEN RETURN [-1, -1]\n    last = findBound(nums, target, False)\n    RETURN [first, last]\nEND FUNCTION\n\nFUNCTION findBound(nums, target, isFirst):\n    low = 0, high = LENGTH(nums) - 1, idx = -1\n    WHILE low <= high DO:\n        mid = (low + high) / 2\n        IF nums[mid] == target THEN:\n            idx = mid\n            IF isFirst THEN high = mid - 1 ELSE low = mid + 1\n        ELSE IF nums[mid] < target THEN low = mid + 1\n        ELSE high = mid - 1\n    END WHILE\n    RETURN idx\nEND FUNCTION",
