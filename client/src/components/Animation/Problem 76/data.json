  "topic": "Sliding Window",
  "algorithm": "Sliding Window with Character Counts",
  "timeComplexity": "O(n + m)",
  "spaceComplexity": "O(1)",
  "oneLinerQuestion": "Find the minimum substring in s that contains all characters of string t.",
  "url": "https://leetcode.com/problems/minimum-window-substring/",
  "explanation": "We use a sliding window. We expand the right pointer to include characters until all required frequency requirements for string t are satisfied, then contract the left pointer to find the minimal valid window size.",
  "pseudoCode": "FUNCTION minWindow(s, t):\n    IF t IS EMPTY THEN RETURN ''\n    countT = FREQ_MAP(t), window = EMPTY_MAP(), have = 0, need = LENGTH(countT)\n    res = [-1, -1], resLen = INF, l = 0\n    FOR r FROM 0 TO LENGTH(s) - 1 DO:\n        c = s[r]; window[c] = window[c] + 1\n        IF c IN countT AND window[c] == countT[c] THEN have = have + 1\n        WHILE have == need DO:\n            IF (r - l + 1) < resLen THEN res = [l, r]; resLen = r - l + 1\n            window[s[l]] = window[s[l]] - 1\n            IF s[l] IN countT AND window[s[l]] < countT[s[l]] THEN have = have - 1\n            l = l + 1\n        END WHILE\n    END FOR\n    RETURN resLen != INF ? SUBSTRING(s, res[0], res[1] + 1) : ''\nEND FUNCTION",
  "renderType": "min_window",
  "initialData": {
    "s": "ADOBECODEBANC",
    "t": "ABC"
  },
  "codeLines": [
    "FUNCTION minWindow(s, t):",
    "    IF t IS EMPTY THEN RETURN ''",
    "    countT = FREQ_MAP(t), window = EMPTY_MAP(), have = 0, need = LENGTH(countT)",
    "    res = [-1, -1], resLen = INF, l = 0",
    "    FOR r FROM 0 TO LENGTH(s) - 1 DO:",
    "        c = s[r]; window[c] = window[c] + 1",
    "        IF c IN countT AND window[c] == countT[c] THEN have = have + 1",
    "        WHILE have == need DO:",
    "            IF (r - l + 1) < resLen THEN res = [l, r]; resLen = r - l + 1",
    "            window[s[l]] = window[s[l]] - 1",
    "            IF s[l] IN countT AND window[s[l]] < countT[s[l]] THEN have = have - 1",
    "            l = l + 1",
    "        END WHILE",
    "    END FOR",
    "    RETURN resLen != INF ? SUBSTRING(s, res[0], res[1] + 1) : ''",
    "END FUNCTION"
  ],
