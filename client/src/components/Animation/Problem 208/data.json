  "oneLinerQuestion": "Implement a trie supporting insert, search, and startsWith methods.",
  "url": "https://leetcode.com/problems/implement-trie-prefix-tree/",
  "explanation": "Store characters in a nested tree where each node points to its children and maintains an isWord flag marking full word completions.",
  "pseudoCode": "CLASS Trie:\n    CONSTRUCTOR(): root = NEW TrieNode()\n    FUNCTION insert(word):\n        curr = root\n        FOR c IN word DO:\n            IF c NOT IN curr.children THEN curr.children[c] = NEW TrieNode()\n            curr = curr.children[c]\n        END FOR\n        curr.isWord = True\n    FUNCTION search(word):\n        node = findNode(word)\n        RETURN node IS NOT NULL AND node.isWord\n    FUNCTION startsWith(prefix):\n        RETURN findNode(prefix) IS NOT NULL\nEND CLASS",
